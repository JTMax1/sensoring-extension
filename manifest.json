{
  "manifest_version": 3,
  "name": "Bleepr - Video Subtitle Profanity Censor & Bleeper",
  "version": "1.0.0",
  "description": "Automatically censors and beeps out profanity in videos using real-time subtitle and caption tracking.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bleepr Controls",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/profanity-rules.js",
        "content/audio-synthesizer.js",
        "content/time-interpolator.js",
        "content/subtitle-masker.js",
        "content/adapters/base-adapter.js",
        "content/adapters/youtube-adapter.js",
        "content/censor-controller.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
